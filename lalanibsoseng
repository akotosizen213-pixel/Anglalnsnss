-- ================================================
-- SILENT AIM HOOK
-- ================================================

-- We hook FindPartOnRayWithWhitelist / Raycast at camera level
-- Real silent aim: redirect bullet origin toward target

local silentTarget = nil  -- updated every frame by aimbot loop

-- Hook workspace:FindPartOnRayWithWhitelist for games using legacy raycast
local oldFPOR = workspace.FindPartOnRayWithWhitelist
workspace.FindPartOnRayWithWhitelist = function(self, ray, whitelist, ...)
    if Config.AimBot.SilentAim and silentTarget then
        local newOrigin    = ray.Origin
        local newDirection = (silentTarget.Position - newOrigin).Unit * ray.Direction.Magnitude
        ray = Ray.new(newOrigin, newDirection)
    end
    return oldFPOR(self, ray, whitelist, ...)
end

-- Hook workspace:Raycast for modern games
local oldRaycast = workspace.Raycast
workspace.Raycast = function(self, origin, direction, params, ...)
    if Config.AimBot.SilentAim and silentTarget then
        direction = (silentTarget.Position - origin).Unit * direction.Magnitude
    end
    return oldRaycast(self, origin, direction, params, ...)
end

