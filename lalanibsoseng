-- Returns the best target part based on FOV + filters
local function getTarget()
    local cam    = workspace.CurrentCamera
    local best   = Config.AimBot.FOVRadius
    local result = nil

    for _,plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if Config.AimBot.TeamCheck and plr.Team == LocalPlayer.Team then continue end

        local char = plr.Character
        if not char then continue end

        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end

        -- Pick target part
        local part
        if Config.AimBot.HitScan == "Head" then
            part = char:FindFirstChild("Head")
        elseif Config.AimBot.HitScan == "Neck" then
            part = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        elseif Config.AimBot.HitScan == "Chest" then
            part = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        else
            part = char:FindFirstChild("HumanoidRootPart")
        end
        if not part then continue end

        -- Wall check using modern Raycast
        if Config.AimBot.WallCheck then
            local origin = cam.CFrame.Position
            local dir    = (part.Position - origin).Unit * 2000
            local params = RaycastParams.new()
            params.FilterDescendantsInstances = {LocalPlayer.Character}
            params.FilterType = Enum.RaycastFilterType.Exclude
            local res = workspace:Raycast(origin, dir, params)
            if res and not res.Instance:IsDescendantOf(char) then continue end
        end

        -- 2D screen distance from crosshair
        local sp, onScreen = cam:WorldToViewportPoint(part.Position)
        if not onScreen then continue end

        local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
        local dist   = (Vector2.new(sp.X, sp.Y) - center).Magnitude

        if dist < best then
            best   = dist
            result = part
        end
    end

    return result
end

RunService.RenderStepped:Connect(function(dt)
    -- Always update silent aim target regardless of key hold
    if Config.AimBot.Enable or Config.AimBot.SilentAim then
        silentTarget = getTarget()
    else
        silentTarget = nil
    end

    -- Regular aimbot needs key held
    if not Config.AimBot.Enable then return end

    local held = Config.AimBot.UseMouse
        and UserInputService:IsMouseButtonPressed(Config.AimBot.MouseBind)
        or  UserInputService:IsKeyDown(Config.AimBot.KeyBind)

    -- Silent aim doesn't need key hold — it hooks rays passively
    -- Regular aim needs the key
    if not held and not Config.AimBot.SilentAim then return end
    if not held then return end  -- silent aim handled via hook, skip camera move

    local part = silentTarget
    if not part then return end

    local cam = workspace.CurrentCamera
    local pos = part.Position

    -- Velocity prediction
    if Config.AimBot.Prediction then
        local vel = part.AssemblyLinearVelocity or Vector3.zero
        pos = pos + vel * (Config.AimBot.PredAmount / 100) * dt
    end

    local sp, onScreen = cam:WorldToViewportPoint(pos)
    if not onScreen then return end

    local smooth = math.max(1, Config.AimBot.Smoothing)

    if Config.AimBot.StickyAim then
        -- Mouse movement method — works on most executors
        local mouse  = UserInputService:GetMouseLocation()
        local nx     = mouse.X + (sp.X - mouse.X) / smooth
        local ny     = mouse.Y + (sp.Y - mouse.Y) / smooth
        local dx, dy = nx - mouse.X, ny - mouse.Y
        moveMouse(dx, dy)
    else
        -- Camera CFrame lerp method — executor independent
        local lookAt = CFrame.lookAt(cam.CFrame.Position, pos)
        cam.CFrame   = cam.CFrame:Lerp(lookAt, 1 / smooth)
    end
end)

